# Hermetic terminfo source for the terminfo-and-tput lab.
# The lab compiles it with tic into a scratch database, so no system entry is needed.
labterm|labalias|lab terminal,
	am, cols#100, lines#30, colors#256,
	bold=\E[1m, sgr0=\E[m,
	cup=\E[%i%p1%d;%p2%dH,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
	labseq=\E[99m,
