filters:
  and:
    - file.inFolder("01-CS-Foundations/Operating-Systems/AOS")
    - file.hasTag("cs6210")
views:
  - type: table
    name: Lessons
    groupBy:
      property: note.part
      direction: ASC
    filters:
      and:
        - file.hasTag("cs6210/lesson")
    order:
      - file.name
      - note.sub_lesson
      - note.status
      - note.last_reviewed
  - type: table
    name: Papers
    filters:
      and:
        - file.hasTag("cs6210/paper")
    order:
      - file.name
      - note.lesson
      - note.reading
      - note.venue
      - note.status
  - type: table
    name: Labs
    filters:
      and:
        - file.hasTag("cs6210/lab")
    order:
      - file.name
      - note.lessons
      - note.environment
      - note.status
